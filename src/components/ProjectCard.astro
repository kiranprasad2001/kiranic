---
import { ArrowRight, ArrowUpRight, Github } from 'lucide-react';

interface Props {
    title: string;
    description: string;
    tags?: string[];
    link?: string;
    github?: string;
    slug?: string;
    year?: string;
}

const { title, description, tags = [], link, github, slug, year } = Astro.props;

const mainHref = slug ? `/work/${slug}` : link;
const isInternal = !!slug;
---

<div class="group flex flex-col p-5 border border-slate-200 dark:border-slate-700/50 rounded-lg hover:border-brand-teal-light dark:hover:border-brand-teal transition-colors h-full bg-white dark:bg-brand-bg">
    <div class="flex justify-between items-start mb-3">
        <h3 class="font-mono font-semibold text-slate-900 dark:text-white text-sm">
            {mainHref ? (
                <a href={mainHref} class="hover:text-brand-teal transition-colors flex items-center gap-1.5">
                    {title}
                    {isInternal ? (
                        <ArrowRight className="h-3.5 w-3.5 opacity-0 group-hover:opacity-100 transition-opacity" />
                    ) : (
                        <ArrowUpRight className="h-3.5 w-3.5 opacity-0 group-hover:opacity-100 transition-opacity" />
                    )}
                </a>
            ) : (
                <span>{title}</span>
            )}
        </h3>

        <div class="flex items-center gap-2">
            {github && (
                <a href={github} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-brand-teal transition-colors" aria-label="View Source on GitHub">
                    <Github class="h-4 w-4" />
                </a>
            )}
        </div>
    </div>

    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4 flex-grow line-clamp-3">
        {description}
    </p>

    <div class="flex items-center justify-between mt-auto pt-3 border-t border-slate-100 dark:border-slate-700/30">
        <div class="flex flex-wrap gap-1.5">
            {tags.slice(0, 3).map((tag) => (
                <span class="text-xs font-mono text-slate-500 dark:text-slate-500">
                    {tag}
                </span>
            ))}
        </div>
        {year && (
            <span class="text-xs text-slate-400 dark:text-slate-500 font-mono">
                {year}
            </span>
        )}
    </div>
</div>
