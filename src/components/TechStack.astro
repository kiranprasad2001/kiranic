---
import { Cloud, Server, Box, Terminal, Database, Code, GitBranch } from 'lucide-react';

const techStack = [
    { icon: Cloud, label: "AWS" },
    { icon: GitBranch, label: "Jenkins" },
    { icon: Server, label: "Quadient" },
    { icon: Database, label: "SmartComms" },
    { icon: Box, label: "Docker" },
    { icon: Terminal, label: "Python" }
];
---

<div class="flex flex-wrap justify-center gap-6">
    {techStack.map(tech => (
        <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
            <tech.icon class="h-4 w-4" title={tech.label} aria-label={tech.label} />
            <span class="text-sm font-mono">{tech.label}</span>
        </div>
    ))}
</div>
