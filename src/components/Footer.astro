---
import { Github, Linkedin, Mail, Rss } from 'lucide-react';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-700/50 mt-auto">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500 dark:text-slate-400">
            <p>&copy; {currentYear} Kiran Prasad</p>

            <nav class="flex items-center gap-5" aria-label="Footer links">
                <a href="/services/quadient-development" class="hover:text-brand-teal transition-colors">Quadient</a>
                <a href="/services/smartcomms-migration" class="hover:text-brand-teal transition-colors">SmartComms</a>
                <span class="text-slate-300 dark:text-slate-600">|</span>
                <a href="https://github.com/kiranprasad2001" target="_blank" rel="noopener noreferrer" class="hover:text-brand-teal transition-colors" aria-label="GitHub"><Github className="h-4 w-4" /></a>
                <a href="https://linkedin.com/in/kiranprasad2001" target="_blank" rel="noopener noreferrer" class="hover:text-brand-teal transition-colors" aria-label="LinkedIn"><Linkedin className="h-4 w-4" /></a>
                <a href="mailto:kp@kiranic.com" class="hover:text-brand-teal transition-colors" aria-label="Email"><Mail className="h-4 w-4" /></a>
                <a href="/rss.xml" class="hover:text-brand-teal transition-colors" aria-label="RSS Feed"><Rss className="h-4 w-4" /></a>
            </nav>
        </div>
    </div>
</footer>
