---
import { Github, Linkedin, Mail, Rss } from 'lucide-react';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-700/50 mt-auto">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500 dark:text-slate-400">
            <p class="flex items-center gap-3">
                <span>&copy; {currentYear} Kiran Prasad</span>
                <button
                    type="button"
                    data-cmdk-open
                    class="hidden sm:inline-flex items-center gap-1 rounded border border-slate-300 dark:border-slate-600 px-1.5 py-0.5 font-mono text-[10px] text-slate-400 hover:border-brand-teal hover:text-brand-teal transition-colors"
                    aria-label="Open command palette"
                >
                    <span>⌘</span>K
                </button>
            </p>

            <nav class="flex items-center gap-5" aria-label="Footer links">
                <a href="/services/quadient-development" class="hover:text-brand-teal transition-colors">Quadient</a>
                <a href="/services/smartcomms-migration" class="hover:text-brand-teal transition-colors">SmartComms</a>
                <a href="/network" class="hover:text-brand-teal transition-colors">Network</a>
                <a href="/colophon" class="hover:text-brand-teal transition-colors">Colophon</a>
                <span class="text-slate-300 dark:text-slate-600">|</span>
                <a href="https://github.com/kiranprasad2001" target="_blank" rel="noopener noreferrer" class="hover:text-brand-teal transition-colors" aria-label="GitHub"><Github className="h-4 w-4" /></a>
                <a href="https://linkedin.com/in/kiranprasad2001" target="_blank" rel="noopener noreferrer" class="hover:text-brand-teal transition-colors" aria-label="LinkedIn"><Linkedin className="h-4 w-4" /></a>
                <a href="mailto:kp@kiranic.com" class="hover:text-brand-teal transition-colors" aria-label="Email"><Mail className="h-4 w-4" /></a>
                <a href="/rss.xml" class="hover:text-brand-teal transition-colors" aria-label="RSS Feed"><Rss className="h-4 w-4" /></a>
            </nav>
        </div>

        <p class="mt-6 text-center font-mono text-[11px] text-slate-400 dark:text-slate-600">
            <span id="footer-ticker">99.9% of this site was written by an AI. The human just hit Enter.</span>
        </p>
    </div>
</footer>

<script>
    const taglines = [
        "99.9% of this site was written by an AI. The human just hit Enter.",
        "Powered by coffee, regret, and a very confident language model.",
        "No engineers were consulted in the making of this footer.",
        "If something's broken, blame the model. If it works, that was the plan.",
        "Shipped on a Friday. Prayed about on Saturday.",
        "This tagline was also generated by an AI. It's models all the way down.",
        "Artisanally sourced buzzwords, free-range hallucinations.",
        "Built with Astro, Tailwind, and an unshakeable sense of irony.",
    ];
    const el = document.getElementById("footer-ticker");
    if (el) {
        // Start somewhere random so repeat visits feel fresh, then rotate.
        let i = Math.floor(Math.random() * taglines.length);
        el.textContent = taglines[i];
        setInterval(() => {
            i = (i + 1) % taglines.length;
            el.style.opacity = "0";
            el.style.transition = "opacity .4s";
            setTimeout(() => {
                el.textContent = taglines[i];
                el.style.opacity = "1";
            }, 400);
        }, 6000);
    }
</script>
