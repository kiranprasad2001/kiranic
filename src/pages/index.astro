---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
import { getEntry, getCollection } from 'astro:content';

const title = "Digital Transformation & Cloud Strategy";
const description = "Enterprise CCM Architect. 13+ years modernizing legacy systems for banking and insurance.";

const resumeEntry = await getEntry('resume', 'kiran');
const experience = resumeEntry.data.experience.slice(0, 4);

const allSlop = await getCollection('slop');
const latestSlop = allSlop.length > 0
    ? allSlop.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0]
    : null;
---

<BaseLayout title={title} description={description}>
    <Navbar />

    <main class="flex-grow">
        {/* Hero — minimal */}
        <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-24 pb-16 md:pt-32 md:pb-24">
            <p class="font-mono text-sm text-brand-teal dark:text-brand-teal-light mb-4 tracking-wide">
                ECM / CCM / CXM / Cloud
            </p>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white mb-6 leading-[1.1] max-w-3xl">
                Architecting the future of digital experience.
            </h1>
            <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mb-10">
                13+ years transforming complex legacy infrastructure into agile, cloud-native ecosystems.
                Specializing in regulatory communications and enterprise content strategies.
            </p>

            <div class="flex flex-wrap items-center gap-4">
                <a
                    href="/work"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-teal text-white font-medium text-sm rounded-md hover:bg-brand-teal/90 transition-colors"
                >
                    View my work <ArrowRight class="w-4 h-4" />
                </a>
                <a
                    href="/lab"
                    class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium text-sm rounded-md hover:border-brand-teal dark:hover:border-brand-teal transition-colors"
                >
                    Visit the lab
                </a>
            </div>

            {/* Latest signal */}
            {latestSlop && (
                <a href={`/ai-slop/${latestSlop.slug}`} class="inline-flex items-center gap-2 mt-8 text-sm text-slate-500 dark:text-slate-400 hover:text-brand-ochre transition-colors group">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-ochre"></span>
                    Latest: {latestSlop.data.headline}
                    <ArrowRight class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" />
                </a>
            )}
        </section>

        {/* Recent work — simple list */}
        <section class="border-t border-slate-200 dark:border-slate-700/50">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="font-mono font-semibold text-slate-900 dark:text-white">Selected work</h2>
                    <a href="/work" class="text-sm text-slate-500 hover:text-brand-teal transition-colors flex items-center gap-1">
                        View all <ArrowRight class="w-3 h-3" />
                    </a>
                </div>

                <div class="space-y-0 divide-y divide-slate-200 dark:divide-slate-700/50">
                    {experience.map(item => (
                        <a href={`/work/${item.slug}`} class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 py-4 group">
                            <div class="flex items-center gap-4">
                                <span class="text-xs font-mono text-slate-400 dark:text-slate-500 w-12 shrink-0">{item.year}</span>
                                <span class="font-medium text-slate-900 dark:text-white group-hover:text-brand-teal transition-colors">{item.title}</span>
                            </div>
                            <div class="flex items-center gap-3 sm:ml-auto">
                                {item.tags.slice(0, 2).map(tag => (
                                    <span class="text-xs font-mono text-slate-400 dark:text-slate-500">{tag}</span>
                                ))}
                                <ArrowRight class="w-3.5 h-3.5 text-slate-300 dark:text-slate-600 group-hover:text-brand-teal transition-colors" />
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        {/* About — compact */}
        <section class="border-t border-slate-200 dark:border-slate-700/50">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
                <div class="flex flex-col md:flex-row gap-8 items-start">
                    <img src="/profile.jpg" alt="Kiran Prasad" class="w-20 h-20 rounded-full object-cover" width="80" height="80" loading="lazy" />
                    <div class="max-w-2xl">
                        <h2 class="font-mono font-semibold text-slate-900 dark:text-white mb-4">About</h2>
                        <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
                            I'm the person who gets called when a 15-year-old system needs to talk to modern infrastructure — and when business teams need someone to explain why the "simple" change isn't actually simple.
                        </p>
                        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                            Outside of work, I run local LLMs on my home setup and build small tools that solve real problems.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
