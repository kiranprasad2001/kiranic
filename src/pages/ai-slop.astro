---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Bot, Terminal, Cpu, Sparkles, AlertTriangle, Rss } from 'lucide-react';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const IconMap: Record<string, any> = {
    Bot, Terminal, Cpu, Sparkles, AlertTriangle
};

const allSlop = await getCollection('slop');
const aiNews = allSlop.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).map(entry => ({
    ...entry.data,
    slug: entry.slug,
    icon: IconMap[entry.data.icon] || Bot
}));
---

<BaseLayout title="Signals from the Latent Space" description="AI-curated daily digest of what matters in AI & tech.">
    <Navbar />

    <main class="flex-grow">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-24">

            {/* Header */}
            <div class="mb-16">
                <div class="flex items-center gap-3 mb-4">
                    <Bot class="w-6 h-6 text-brand-teal dark:text-brand-teal-light" />
                    <a href="/rss.xml" class="text-xs font-mono text-brand-ochre hover:underline" target="_blank">RSS</a>
                </div>
                <h1 class="font-mono text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight">
                    Signals from the Latent Space
                </h1>
                <p class="text-slate-600 dark:text-slate-400 max-w-xl">
                    AI-curated daily digest of what matters in AI & tech. Real stories, synthesized by Gemini.
                </p>
            </div>

            {/* News Grid */}
            <div class="grid gap-6 md:grid-cols-2">
                {aiNews.map((news) => (
                    <a href={`/ai-slop/${news.slug}`} class="group block border border-slate-200 dark:border-slate-700/50 rounded-lg p-6 hover:border-brand-teal-light dark:hover:border-brand-teal transition-colors bg-white dark:bg-brand-bg">
                        <div class="flex items-start justify-between mb-4">
                            <news.icon class="w-5 h-5 text-slate-400 dark:text-slate-500 group-hover:text-brand-teal transition-colors" />
                            <span class="text-xs font-mono text-slate-400 dark:text-slate-500">
                                {news.date.toISOString().split('T')[0]}
                            </span>
                        </div>
                        <h2 class="font-semibold text-slate-900 dark:text-white mb-2 group-hover:text-brand-teal transition-colors leading-snug">
                            {news.headline}
                        </h2>
                        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4 line-clamp-2">
                            {news.summary}
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {news.tags.map(tag => (
                                <span class="text-xs font-mono text-slate-400 dark:text-slate-500">#{tag}</span>
                            ))}
                        </div>
                    </a>
                ))}
            </div>

            <Newsletter />
        </div>
    </main>

    <Footer />
</BaseLayout>
