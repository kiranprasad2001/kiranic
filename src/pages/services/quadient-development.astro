---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import DocumentWorkflow from '../../components/DocumentWorkflow';
import { Server, Cloud, Code, ArrowRight } from 'lucide-react';

const title = "Quadient Inspire Developer & Architect";
const description = "Specializing in Quadient Inspire migration, performance optimization, and cloud deployment.";
const keywords = "Quadient Inspire, CCM Migration, Quadient Scaler, Customer Communication Management";
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <Navbar />

    <main class="flex-grow">
        {/* Hero */}
        <section class="bg-brand-bg text-white pt-24 pb-16">
            <div class="max-w-5xl mx-auto px-4 sm:px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <p class="font-mono text-sm text-brand-teal-light mb-4 tracking-wide">Enterprise CCM Solutions</p>
                        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
                            Mastering Quadient Inspire for cloud scale.
                        </h1>
                        <p class="text-slate-400 text-lg mb-8 max-w-lg leading-relaxed">
                            Stop struggling with legacy on-prem layouts. I re-architect Quadient workflows for performance, maintainability, and cloud-native deployment.
                        </p>
                        <a href="mailto:kp@kiranic.com" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-teal text-white font-medium text-sm rounded-md hover:bg-brand-teal/90 transition-colors">
                            Consult on Migration
                        </a>
                    </div>
                    <div class="border border-slate-700/50 rounded-lg p-6">
                        <DocumentWorkflow client:load />
                        <p class="text-center text-xs text-slate-500 mt-4 font-mono">Interactive Workflow Visualization</p>
                    </div>
                </div>
            </div>
        </section>

        {/* Services */}
        <section class="py-20">
            <div class="max-w-5xl mx-auto px-4 sm:px-6">
                <h2 class="font-mono text-xl font-bold text-slate-900 dark:text-white mb-3 text-center">Why Enterprise Teams Hire Me</h2>
                <p class="text-slate-600 dark:text-slate-400 text-center mb-12 max-w-2xl mx-auto">
                    Most Quadient implementations are stuck in 2015. I bring modern DevOps, CI/CD, and Cloud patterns to the CCM world.
                </p>

                <div class="grid md:grid-cols-3 gap-6">
                    {[
                        { icon: Server, title: "Legacy Migration", desc: "Moving from print-first monoliths to omni-channel, API-driven communication services." },
                        { icon: Cloud, title: "Cloud Deployment", desc: "Architecting Quadient Scaler and Inspire on AWS/Azure using Docker and Kubernetes." },
                        { icon: Code, title: "Automation & CI/CD", desc: "Treating templates as code. Automated testing, version control, and deployment pipelines." }
                    ].map(service => (
                        <div class="p-6 border border-slate-200 dark:border-slate-700/50 rounded-lg">
                            <service.icon class="w-8 h-8 text-brand-teal mb-4" />
                            <h3 class="font-semibold text-slate-900 dark:text-white mb-2">{service.title}</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{service.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* CTA */}
        <section class="border-t border-slate-200 dark:border-slate-700/50 py-16">
            <div class="max-w-3xl mx-auto px-4 text-center">
                <h2 class="font-mono font-bold text-xl text-slate-900 dark:text-white mb-4">Need a sanity check on your architecture?</h2>
                <p class="text-slate-600 dark:text-slate-400 mb-6">Let's review your WFDs and deployment strategy.</p>
                <a href="mailto:kp@kiranic.com" class="inline-flex items-center gap-2 text-brand-teal font-medium hover:underline">
                    Schedule an Audit <ArrowRight class="w-4 h-4" />
                </a>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
