---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { Database, Zap, RefreshCw, ArrowRight } from 'lucide-react';

const title = "SmartComms Migration Specialist";
const description = "Expert in SmartComms implementation, template migration, and optimizing complex appliance architectures.";
const keywords = "SmartComms, SC Migrator, Thunderhead, SmartCommunications, CCM";
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <Navbar />

    <main class="flex-grow">
        {/* Hero */}
        <section class="bg-brand-bg text-white pt-24 pb-16">
            <div class="max-w-5xl mx-auto px-4 sm:px-6">
                <p class="font-mono text-sm text-brand-ochre mb-4 tracking-wide">SmartCommunications Expert</p>
                <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight max-w-3xl">
                    Seamless SmartComms integrations.
                </h1>
                <p class="text-slate-400 text-lg mb-8 max-w-xl leading-relaxed">
                    I help regulated enterprises maximize their investment in SmartCommunications.
                    From complex draft editor implementations to high-volume batch generation.
                </p>
                <a href="mailto:kp@kiranic.com" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-ochre text-white font-medium text-sm rounded-md hover:bg-brand-ochre/90 transition-colors">
                    Discuss Strategy
                </a>
            </div>
        </section>

        {/* Features */}
        <section class="py-20">
            <div class="max-w-5xl mx-auto px-4 sm:px-6">
                <div class="grid md:grid-cols-3 gap-6">
                    {[
                        { icon: RefreshCw, title: "Migration Strategy", desc: "Moving from Thunderhead/NOW to SmartComms Cloud. Safe, phased migration with zero data loss." },
                        { icon: Database, title: "Data Integration", desc: "Connecting SmartComms to Salesforce, Guidewire, or custom APIs. Robust data models that scale." },
                        { icon: Zap, title: "Interactive Documents", desc: "Complex Draft Editor experiences. Business users customize communications within compliance guardrails." }
                    ].map(feature => (
                        <div class="p-6 border border-slate-200 dark:border-slate-700/50 rounded-lg">
                            <feature.icon class="w-8 h-8 text-brand-ochre mb-4" />
                            <h3 class="font-semibold text-slate-900 dark:text-white mb-2">{feature.title}</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{feature.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* CTA */}
        <section class="border-t border-slate-200 dark:border-slate-700/50 py-16">
            <div class="max-w-3xl mx-auto px-4 text-center">
                <h2 class="font-mono font-bold text-xl text-slate-900 dark:text-white mb-4">Ready to modernize your CCM stack?</h2>
                <a href="mailto:kp@kiranic.com" class="inline-flex items-center gap-2 text-brand-ochre font-medium hover:underline">
                    Get in touch <ArrowRight class="w-4 h-4" />
                </a>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
