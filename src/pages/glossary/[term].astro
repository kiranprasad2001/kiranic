---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { BookOpen, ArrowLeft } from 'lucide-react';
import glossaryData from '../../data/glossary.json';

export async function getStaticPaths() {
    return glossaryData.map((entry) => ({
        params: {
            term: entry.term.toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/(^-|-$)/g, '')
        },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { term, definition } = entry;

const title = `What is ${term}? | Enterprise CCM Glossary`;
const description = `Definition of ${term}: ${definition}`;
const keywords = `${term}, ${term} definition, CCM glossary, Enterprise Architecture`;
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <Navbar />

    <main class="flex-grow max-w-3xl mx-auto px-4 sm:px-6 py-16">

        <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-teal mb-8 transition-colors">
            <ArrowLeft class="w-3.5 h-3.5" /> Back to Home
        </a>

        <article>
            <div class="flex items-center gap-3 mb-6">
                <BookOpen class="w-6 h-6 text-brand-teal" />
                <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">{term}</h1>
            </div>

            <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed border-l-2 border-brand-teal pl-4 mb-10">
                {definition}
            </p>

            <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-mono prose-a:text-brand-teal">
                <h2>Why this matters for Enterprise Architecture</h2>
                <p>
                    In the context of modern Digital Experience Platforms (DXP), understanding <strong>{term}</strong> is critical for architects migrating from legacy monoliths.
                    Effective implementation of {term} strategies can significantly reduce technical debt and improve time-to-market for regulated communications.
                </p>
            </div>

            <div class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-700/50">
                <h3 class="font-mono text-sm font-semibold text-slate-900 dark:text-white mb-3">Related Services</h3>
                <ul class="space-y-1 text-sm">
                    <li><a href="/services/quadient-development" class="text-brand-teal hover:underline">Quadient Inspire Development</a></li>
                    <li><a href="/services/smartcomms-migration" class="text-brand-teal hover:underline">SmartComms Migration</a></li>
                </ul>
            </div>
        </article>
    </main>

    <Footer />
</BaseLayout>
