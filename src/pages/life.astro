---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const title = "Life";

const lifeItems = [
    {
        title: "Photography",
        description: "A gallery of moments captured with my mirrorless camera setup. Focusing on street photography and landscapes.",
        tags: ["Sony Alpha", "Lightroom"],
        year: "Hobby"
    },
    {
        title: "Cycling",
        description: "Exploring trails and tracks on two wheels.",
        tags: ["Cycling", "Strava", "Outdoors"],
        year: "Active"
    },
    {
        title: "HomeLab",
        description: "Self-hosting infrastructure at home. Managing an Immich server for photo aggregation and backup.",
        tags: ["Docker", "Immich", "Unraid"],
        year: "Active"
    },
    {
        title: "AI Tinkering",
        description: "Building with LLMs, experimenting with agents, fine-tuning models, and exploring what's possible at the frontier.",
        tags: ["LLMs", "Agents", "Claude", "Local Models"],
        year: "Active"
    }
];
---

<BaseLayout title={title} description="Beyond the code: photography, cycling, AI tinkering, and hardware.">
    <Navbar />

    <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 py-16 w-full">
        <div class="mb-12">
            <h1 class="font-mono text-2xl font-bold text-slate-900 dark:text-white mb-2">Life & Hobbies</h1>
            <p class="text-slate-600 dark:text-slate-400">
                Beyond the code: photography, cycling, AI tinkering, and hardware.
            </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {lifeItems.map(item => (
                <ProjectCard {...item} />
            ))}
        </div>
    </main>

    <Footer />
</BaseLayout>
